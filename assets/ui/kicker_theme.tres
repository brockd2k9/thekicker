[gd_resource type="Theme" load_steps=6 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Barlow-SemiBold.ttf" id="1_body"]
[ext_resource type="FontFile" path="res://assets/fonts/Oswald-Variable.ttf" id="2_oswald"]
