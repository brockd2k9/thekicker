; Engine configuration file.
; Godot 4.7 (GDScript; 4.3+ should also work). Open this folder in the Godot editor.

config_version=5

[application]

config/name="Kicker"
config/description="Flick-to-kick field goal game."
config/version="0.2.0"
run/main_scene="res://scenes/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; Android back button is handled by the screens (back to menu / pause), not app quit.
config/quit_on_go_back=false

[autoload]

TeamDatabase="*res://scripts/teams/team_database.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Haptics="*res://scripts/autoload/haptics.gd"
Music="*res://scripts/autoload/music.gd"
Toast="*res://scripts/ui/toast.gd"
ScreenFade="*res://scripts/ui/screen_fade.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/kicker_theme.tres"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
