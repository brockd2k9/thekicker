static var _cache := {}


## The icon `name` drawn at `px` pixels in `color` (cached).
static func texture(name: String, color: Color, px: int = 40) -> Texture2D:
	var key := "%s|%s|%d" % [name, color.to_html(), px]
	if _cache.has(key):
		return _cache[key]
	var d: String = PATHS.get(name, PATHS["info"])
	var svg := '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="%s">' % [px, px, VIEWBOX] \
		+ '<path fill="#%s" fill-opacity="%.3f" d="%s"/></svg>' % [color.to_html(false), color.a, d]
	var img := Image.new()
	if img.load_svg_from_string(svg, 1.0) != OK:
		return null
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex


## A TextureRect for `name` (mouse-transparent, fixed size).
static func rect(name: String, color: Color, px: int = 40) -> TextureRect:
	var r := TextureRect.new()
	r.texture = texture(name, color, px)
	r.custom_minimum_size = Vector2(px, px)
	r.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return r


static func names() -> Array:
	return PATHS.keys()
